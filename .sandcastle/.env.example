# ==============================================================================
# Sandcastle Environment Configuration for Findeg
# ==============================================================================

# Option 1: Claude Code OAuth Token (Recommended)
# Run `claude setup-token` on your host machine to authorize Sandcastle to use
# your existing Claude subscription without consuming direct API credits.
CLAUDE_CODE_OAUTH_TOKEN=

# Option 2: Anthropic API Key
# If you prefer paying per token rather than using your Claude subscription:
# ANTHROPIC_API_KEY=

# GitHub Fine-Grained Personal Access Token (Required)
# Sandcastle uses this inside the sandbox to query `ready-for-agent` issues,
# post comments, and close completed issues.
# Create token at: https://github.com/settings/personal-access-tokens/new
# Required permissions:
#   - Repository Permissions:
#       - Issues: Read and write
#       - Pull requests: Read and write (if using PR workflow)
#       - Contents: Read and write
#       - Metadata: Read
GH_TOKEN=

# Optional: Default Model Override
SANDCASTLE_AGENT_MODEL=claude-sonnet-4-6
