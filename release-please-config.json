{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "always-update": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Added",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Fixed",
      "hidden": false
    },
    {
      "type": "perf",
      "section": "Changed",
      "hidden": false
    },
    {
      "type": "refactor",
      "section": "Changed",
      "hidden": false
    },
    {
      "type": "revert",
      "section": "Reverted",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "style",
      "section": "Style",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG.md"
    }
  }
}
