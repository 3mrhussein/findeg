# Backend Package Environment Variables

# JWT Authentication Secrets
# Generate secure random strings (minimum 32 characters)
# You can use: openssl rand -base64 32

JWT_SECRET=your-super-secret-jwt-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-token-key-min-32-chars

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/findeg

# CMS Configuration (if using external CMS)
# CMS_API_URL=https://your-cms-api.com
# CMS_API_KEY=your-cms-api-key

# Email Service (Resend)
# RESEND_API_KEY=re_your_resend_api_key

# Storage (for file uploads)
# STORAGE_BUCKET=your-storage-bucket
# STORAGE_REGION=your-region

# Application
NODE_ENV=development
