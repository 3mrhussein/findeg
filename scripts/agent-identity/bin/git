#!/bin/sh
# git, authenticating to github.com as the current agent's GitHub App
# ($FINDEG_AGENT). The empty helper clears the user's own helpers (keychain,
# store) so they neither answer for the agent nor save its tokens.
# Put on PATH by `token.mjs <agent> env`; see docs/agents/agent-identity.md.
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$here" | paste -sd: -)
export PATH
token_script="$here/../token.mjs"
exec git \
  -c credential.helper= \
  -c "credential.helper=!node '$token_script' '${FINDEG_AGENT:?FINDEG_AGENT is not set}' git-credential" \
  "$@"
