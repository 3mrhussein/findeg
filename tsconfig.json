{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/app/*": [
        "./packages/storefront/src/app/*",
        "./packages/backend/src/app/*",
        "./packages/dashboard/src/app/*",
        "./src/app/*"
      ],
      "@/features/*": [
        "./packages/backend/src/features/*",
        "./src/features/*"
      ]
    }
  },
    "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "fullstack-ecommerce",
    "cypress",
    "cypress.config.ts",
    "src/features._migrated"
  ]
}
