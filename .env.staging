# Staging Environment Configuration
# Copy this to .env.staging and update values

# Database
# Note: Staging often uses a managed database or a dedicated container
DATABASE_URL=postgresql://findeg_user:staging_password@staging-db.internal:5432/findeg_staging

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://staging.findeg.com

# CMS
CMS_API_URL=https://cms.internal/v1
CMS_API_KEY=stg_key_...

# AI/Other
GOOGLE_AI_API_KEY=...
