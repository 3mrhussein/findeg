{
  "name": "findeg-app",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm runtime:compile && pnpm --filter @findeg/web dev",
    "build": "pnpm runtime:build",
    "start": "pnpm start:web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "architecture:check": "node scripts/architecture-check.mjs",
    "test:architecture": "node --test scripts/architecture-check.test.mjs",
    "typegen": "pnpm --filter @findeg/storefront exec next typegen && pnpm --filter @findeg/dashboard exec next typegen && pnpm --filter @findeg/web exec next typegen",
    "quality:check": "pnpm runtime:build && pnpm architecture:check && pnpm test:architecture && pnpm typegen && pnpm type-check && pnpm test && pnpm test:runtime",
    "db:run": "docker compose up -d postgres",
    "db:reset": "docker compose down -v ",
    "db:rebuild": "pnpm db:reset && pnpm db:run && pnpm --filter @findeg/db db:setup",
    "db:setup": "pnpm db:run && pnpm --filter @findeg/db db:setup",
    "db:studio": "pnpm db:run && pnpm --filter @findeg/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules .turbo && pnpm clean:next",
    "clean:next": "rm -rf frontend/dashboard/.next frontend/storefront/.next",
    "kill": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null || true",
    "prepare": "husky",
    "dev:legacy": "pnpm db:run && turbo run dev --filter=@findeg/storefront --filter=@findeg/dashboard",
    "runtime:compile": "turbo run build --filter=@findeg/runtime...",
    "runtime:build": "pnpm runtime:compile && pnpm --filter @findeg/web build",
    "start:web": "pnpm --filter @findeg/web start",
    "start:worker": "pnpm --filter @findeg/runtime worker",
    "migrate": "pnpm --filter @findeg/runtime migrate",
    "test:runtime": "node --test tests/runtime-processes.test.mjs && node scripts/test-runtime-migrations.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "turbo": "^2.9.12",
    "typescript": "^5.7.3"
  }
}
