{
  "name": "findeg-app",
  "version": "1.0.0",
  "description": "FindEg.com E-commerce Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "next build",
    "start": "next start",
    "lint": "npm run type-check && npm run lint:eslint",
    "lint:eslint": "eslint src",
    "lint:fix": "eslint src --fix",
    "type-check": "tsc --noEmit",
    "db:start": "./scripts/db-start.sh",
    "db:up": "npm run db:start",
    "db:stop": "./scripts/db-stop.sh",
    "db:down": "npm run db:stop",
    "db:reset": "./scripts/db-reset.sh",
    "db:logs": "./scripts/db-logs.sh",
    "db:shell": "docker-compose exec postgres psql -U findeg_user -d findeg_dev",
    "db:status": "docker-compose ps && docker-compose exec postgres pg_isready -U findeg_user",
    "db:setup": "npm run db:start && npm run db:push && npm run db:seed",
    "db:generate": "drizzle-kit generate --config src/infrastructure/database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/infrastructure/database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config src/infrastructure/database/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config src/infrastructure/database/drizzle.config.ts",
    "db:seed": "node scripts/seed-db.js",
    "db:doc": "node scripts/generate-schema-doc.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "next": "^16.0.0",
    "next-intl": "^4.7.0",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-prettier": "^5.5.5",
    "postcss": "^8.4.49",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "react",
    "ecommerce",
    "tailwindcss",
    "nextjs"
  ],
  "author": "FindEg Team"
}
