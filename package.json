{
  "name": "findeg-app",
  "version": "1.0.0",
  "description": "FindEg.com E-commerce Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint:fix": "eslint src --fix",
    "i18n:check": "node scripts/validate-i18n.mjs",
    "test": "npm run type-check && npm run test:unit && npm run test:e2e",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "type-check": "turbo run type-check",
    "type-check:backend": "pnpm --filter @findeg/backend type-check",
    "type-check:ui": "pnpm --filter @findeg/ui type-check",
    "type-check:dashboard": "pnpm --filter @findeg/dashboard type-check",
    "type-check:storefront": "pnpm --filter @findeg/storefront type-check",
    "db:start": "./packages/backend/scripts/db-start.sh",
    "db:stop": "./packages/backend/scripts/db-stop.sh",
    "db:reset": "./packages/backend/scripts/db-reset.sh",
    "db:logs": "./packages/backend/scripts/db-logs.sh",
    "db:shell": "docker-compose exec postgres psql -U findeg_user -d findeg_dev",
    "db:status": "docker-compose ps && docker-compose exec postgres pg_isready -U findeg_user",
    "db:setup": "npm run db:start && npm run db:push && npm run db:seed",
    "db:generate": "drizzle-kit generate --config packages/backend/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/backend/drizzle.config.ts",
    "db:push": "drizzle-kit push --config packages/backend/drizzle.config.ts --force",
    "db:seed": "node packages/backend/scripts/seed-db.js",
    "db:seed-brands": "npx tsx --tsconfig packages/backend/tsconfig.json packages/backend/scripts/seed-brands.ts",
    "db:studio": "drizzle-kit studio --config packages/backend/drizzle.config.ts",
    "db:doc": "node packages/backend/scripts/generate-schema-doc.js",
    "changelog": "node scripts/generate-changelog.js",
    "changelog:preview": "npm run changelog -- --stdout",
    "changelog:check": "npm run changelog -- --check",
    "e2e:open": "cypress open",
    "e2e:run": "cypress run --browser chrome --headless --reporter spec",
    "e2e:run:ci": "npm run e2e:run -- --reporter junit --reporter-options mochaFile=cypress/reports/junit-[hash].xml,toConsole=false",
    "e2e:run:headed": "npm run e2e:run -- --headed",
    "e2e:verify": "cypress verify",
    "dev:storefront": "pnpm --filter @findeg/storefront dev",
    "dev:dashboard": "pnpm --filter @findeg/dashboard dev",
    "dev:both": "pnpm --parallel --filter @findeg/storefront --filter @findeg/dashboard dev"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.8.0",
    "start-server-and-test": "^3.0.0",
    "turbo": "^2.9.3",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "react",
    "ecommerce",
    "tailwindcss",
    "nextjs"
  ],
  "author": "FindEg Team",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "server-only": "^0.0.1"
  }
}
