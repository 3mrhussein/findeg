{
  "name": "findeg-app",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm db:run && turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint -- --fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "pnpm --workspace-concurrency=1 --filter @findeg/config --filter @findeg/catalog --filter @findeg/inventory --filter @findeg/orders --filter @findeg/school-lists --filter @findeg/partners --filter @findeg/backend run test:integration",
    "test:architecture": "node --test scripts/architecture/*.test.mjs",
    "db:run": "docker compose up -d postgres",
    "db:reset": "docker compose down -v ",
    "db:rebuild": "pnpm db:reset && pnpm db:run && pnpm --filter @findeg/db db:setup",
    "db:setup": "pnpm db:run && pnpm --filter @findeg/db db:setup",
    "db:studio": "pnpm db:run && pnpm --filter @findeg/db db:studio",
    "clean": "turbo run clean && rm -rf node_modules .turbo && pnpm clean:next",
    "clean:next": "rm -rf frontend/dashboard/.next frontend/storefront/.next",
    "kill": "lsof -ti:3000,3001 | xargs kill -9 2>/dev/null || true",
    "wt:new": "node scripts/worktree.mjs create",
    "wt:rm": "node scripts/worktree.mjs remove",
    "wt:prune": "node scripts/worktree.mjs prune",
    "wt:list": "node scripts/worktree.mjs list"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
