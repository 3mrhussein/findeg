{
  "name": "findeg-app",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm runtime:compile && pnpm --filter @findeg/web dev",
    "build": "pnpm runtime:build",
    "start": "pnpm start:web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "architecture:check": "node scripts/architecture-check.mjs",
    "test:architecture": "node --test scripts/architecture-check.test.mjs tests/openapi-contract.test.mjs tests/http-contract-boundaries.test.mjs",
    "typegen": "pnpm --filter @findeg/web exec next typegen",
    "quality:check": "pnpm runtime:build && pnpm lint && pnpm architecture:check && pnpm test:architecture && pnpm typegen && pnpm type-check && pnpm test && pnpm test:runtime",
    "db:run": "docker compose up -d postgres",
    "db:reset": "docker compose down -v",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "kill": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true",
    "prepare": "husky",
    "runtime:compile": "turbo run build --filter=@findeg/runtime...",
    "runtime:build": "pnpm runtime:compile && pnpm --filter @findeg/web build",
    "start:web": "pnpm --filter @findeg/web start",
    "start:worker": "pnpm --filter @findeg/runtime worker",
    "migrate": "pnpm --filter @findeg/runtime migrate",
    "test:runtime": "node --test tests/runtime-processes.test.mjs && node scripts/test-runtime-migrations.mjs",
    "security:check": "pnpm audit --prod --audit-level high"
  },
  "devDependencies": {
    "ajv": "6.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "turbo": "^2.9.12",
    "typescript": "^5.7.3",
    "yaml": "2.9.0"
  }
}
