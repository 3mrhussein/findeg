{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "..",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Node",
    "paths": {
      "@findeg/db/*": ["./*"],
      "@findeg/env": ["../env.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.json",
    "../env.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "migrations",
    "**/*.test.ts"
  ]
}
