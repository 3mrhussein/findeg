{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "noEmit": false,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "dist",
        // IMPORTANT: keep src-based root (correct for your structure)
        "rootDir": "src",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "migrations",
        "**/*.test.ts"
    ],
    "references": [
        { "path": "../packages/env" }
    ]
}
