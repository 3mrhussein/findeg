{
    "name": "@findeg/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./index.ts",
    "types": "./index.ts",
    "exports": {
        ".": "./index.ts",
        "./schema": "./schema/index.ts",
        "./queries": "./queries/index.ts",
        "./connection": "./connection.ts",
        "./types": "./types/index.ts"
    },
    "scripts": {
        "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
        "db:migrate": "tsx --env-file=../.env ./migrate.ts",
        "db:push": "drizzle-kit push --force --config ./drizzle.config.ts",
        "db:seed": "cross-env DB_SEEDING=true tsx --env-file=../.env ./seed.ts",
        "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
        "type-check": "tsc --noEmit"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "drizzle-orm": "^0.45.2",
        "postgres": "^3.4.5",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^25.6.0",
        "cross-env": "^7.0.3",
        "drizzle-kit": "^0.30.1",
        "eslint-config-next": "^16.2.4",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}