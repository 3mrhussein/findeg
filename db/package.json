{
  "name": "@findeg/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": "./src/index.ts",
    "./connection": "./src/connection.ts",
    "./schema": "./src/schema/index.ts",
    "./queries": "./src/queries/index.ts",
    "./queries/partners": "./src/queries/partners/index.ts",
    "./queries/partner-sales": "./src/queries/partner-sales/index.ts",
    "./queries/school-supply-lists": "./src/queries/school-supply-lists/index.ts",
    "./queries/school-directory": "./src/queries/school-directory/index.ts",
    "./types": "./src/types/index.ts",
    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "db:migrate": "cross-env DB_MIGRATING=true tsx --env-file=../.env ./migrate.ts",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "db:seed": "cross-env DB_SEEDING=true tsx --env-file=../.env ./seed.ts",
    "db:drop": "drizzle-kit drop --config ./drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config ./drizzle.config.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "clean": " rm -rf node_modules dist .turbo",
    "test": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@findeg/env": "workspace:*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@findeg/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^1.6.1"
  }
}
