{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@lib/*": ["./src/lib/*"],
      "@providers/*": ["./src/providers/*"],
      "@server/*": ["./src/server/*"],
      "@features/*": ["./src/features/*"],
      "@app/*": ["./src/app/*"],
      "@ui": ["../ui/src"],
      "@ui/*": ["../ui/src/*"],
      "@backend": ["../backend/src"],
      "@backend/*": ["../backend/src/*"]
    }
  },
  "references": [
    {
      "path": "../ui"
    },
    {
      "path": "../backend"
    }
  ],
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": ["node_modules", ".next", "dist", "cypress"]
}
