{
  "name": "storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run type-check && npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "start-server-and-test start http-get://localhost:3000 'cypress run --browser chrome --headless'",
    "test:e2e:dev": "start-server-and-test 'next dev --port 3000' http-get://localhost:3000 'cypress run --browser chrome --headless'",
    "e2e:run": "cypress run",
    "e2e:run:ci": "cypress run --browser chrome --headless",
    "e2e:open": "cypress open"
  },
  "dependencies": {
    "@backend": "workspace:backend@*",
    "@hookform/resolvers": "^5.2.2",
    "@ui": "workspace:ui@*",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.4.7",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.563.0",
    "next": "^16.2.4",
    "next-intl": "^4.7.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "cypress": "^15.10.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.5.4",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vitest": "^1.3.0"
  }
}