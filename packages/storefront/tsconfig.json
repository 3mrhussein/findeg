{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@server/*": [
        "./src/server/*"
      ],
      "@features/*": [
        "./src/features/*",
        "../backend/src/features/*"
      ],
      "@/features/*": [
        "./src/features/*",
        "../backend/src/features/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@backend": [
        "../backend/src"
      ],
      "@backend/*": [
        "../backend/src/*"
      ],
      "@ui": [
        "../ui/src"
      ],
      "@ui/*": [
        "../ui/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "cypress"
  ]
}
