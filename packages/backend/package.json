  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "cypress run",
    "e2e:run": "cypress run",
    "e2e:run:ci": "cypress run --browser chrome --headless",
