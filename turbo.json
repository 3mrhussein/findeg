{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.*",
    "tsconfig.base.json",
    "package.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    // ----------------------------
    // BUILD PIPELINE (CORE FLOW)
    // ----------------------------
    "build": {
      "dependsOn": [
        "type-check"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    // ----------------------------
    // DEV MODE
    // ----------------------------
    "dev": {
      "cache": false,
      "persistent": true
    },
    // ----------------------------
    // TYPE CHECKING
    // ----------------------------
    "type-check": {
      "outputs": []
    },
    // ----------------------------
    // LINT
    // ----------------------------
    "lint": {
      "outputs": []
    },
    // ----------------------------
    // TESTING
    // ----------------------------
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ]
    },
    "test:unit": {
      "outputs": [
        "coverage/**"
      ]
    },
    "test:e2e": {
      "cache": false
    },
    // ----------------------------
    // NEXT APPS
    // ----------------------------
    "start": {
      "cache": false
    },
    // ----------------------------
    // DATABASE PIPELINE (CRITICAL)
    // ----------------------------
    "db:generate": {
      "cache": false,
      "outputs": [
        "db/migrations/**"
      ]
    },
    "db:migrate": {
      "dependsOn": [
        "db:generate"
      ],
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": [
        "db:push"
      ],
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    // ----------------------------
    // CLEAN
    // ----------------------------
    "clean": {
      "cache": false
    }
  }
}