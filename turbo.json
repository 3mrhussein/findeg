{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build",
        "type-check",
        "lint"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type-check": {
      "cache": true,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tsconfig*.json"
      ]
    },
    "lint": {
      "cache": true,
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "eslint.config.*",
        ".eslintrc*"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:unit": {
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "vitest.config.*"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "start": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "db:generate": {
      "cache": false,
      "inputs": [
        "schema/**/*.ts",
        "drizzle.config.ts"
      ]
    },
    "db:migrate": {
      "cache": false,
      "dependsOn": [
        "db:generate"
      ]
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false,
      "dependsOn": [
        "db:push"
      ]
    }
  }
}