{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^type-check"]
    },
    "lint": {},
    "test": {},
    "test:unit": {
      "dependsOn": ["^test:unit"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
