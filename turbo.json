{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.*", "tsconfig.base.json", "package.json"],
  "globalEnv": ["NODE_ENV", "CI", "RELEASE_REVISION"],
  "tasks": {
    // ----------------------------
    // BUILD PIPELINE (CORE FLOW)
    // ----------------------------
    "build": {
      "dependsOn": ["^build", "type-check"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "cache": true
    },
    // ----------------------------
    // DEV MODE
    // ----------------------------
    "dev": {
      "cache": false,
      "persistent": true
    },
    // ----------------------------
    // TYPE CHECKING
    // ----------------------------
    "type-check": {
      "dependsOn": ["^build"],
      "cache": false
    },
    // ----------------------------
    // LINT
    // ----------------------------
    "lint": {
      "outputs": [],
      "cache": false
    },
    // ----------------------------
    // TESTING
    // ----------------------------
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": {
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "cache": false
    },
    // ----------------------------
    // NEXT APPS
    // ----------------------------
    "start": {
      "cache": false
    },
    // ----------------------------
    // DATABASE PIPELINE (CRITICAL)
    // ----------------------------
    "db:generate": {
      "cache": false,
      "outputs": ["db/migrations/**"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    // ----------------------------
    // CLEAN
    // ----------------------------
    "clean": {
      "cache": false
    }
  }
}
