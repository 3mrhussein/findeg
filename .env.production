# Production Environment Configuration
# Copy this to .env.production and update values

# Database
# ALWAYS use SSL for production database connections
# DATABASE_URL=postgresql://user:password@prod-db.host:5432/dbname?sslmode=require
DATABASE_URL=...

# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://findeg.com

# CMS
CMS_API_URL=https://api.cms.com/v1
CMS_API_KEY=prod_key_...

# Security & Secrets
NEXTAUTH_SECRET=...
NEXTAUTH_URL=https://findeg.com
