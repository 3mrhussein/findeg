# FindEg Admin Dashboard Environment Variables

# Application
NEXT_PUBLIC_APP_NAME="FindEg Admin Dashboard"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Database (shared with backend package)
DATABASE_URL="postgresql://findeg_user:findeg_password@localhost:5432/findeg_dev"

# Authentication (shared secrets with backend)
JWT_SECRET="your-secret-key-change-in-production-minimum-32-characters"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production-minimum-32-characters"

# Optional: Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
