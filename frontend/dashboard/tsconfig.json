{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@hooks/*": [
        "./src/hooks/*"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@providers/*": [
        "./src/providers/*"
      ],
      "@server/*": [
        "./src/server/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@actions/*": [
        "./src/actions/*"
      ],
      "@types/*": [
        "./src/types/*"
      ],
      "@queries/*": [
        "./src/queries/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@findeg/backend": [
        "../../backend/src"
      ],
      "@findeg/backend/*": [
        "../../backend/src/*"
      ],
      "@findeg/ui": [
        "../ui/src"
      ],
      "@findeg/ui/*": [
        "../ui/src/*"
      ]
    }
  },
  "references": [
    {
      "path": "../../backend"
    },
    {
      "path": "../ui"
    }
  ],
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "cypress"
  ]
}
