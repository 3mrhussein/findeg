{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@lib/*": ["./src/lib/*"],
      "@providers/*": ["./src/providers/*"],
      "@server/*": ["./src/server/*"],
      "@features/*": ["./src/features/*"],
      "@data/*": ["./src/data/*"],
      "@app/*": ["./src/app/*"],
      "@findeg/env": ["../../packages/env/src"],
      "@findeg/env/*": ["../../packages/env/src/*"],
      "@findeg/backend": ["../../backend/src"],
      "@findeg/backend/*": ["../../backend/src/*"],
      "@findeg/db": ["../../db/src"],
      "@findeg/db/*": ["../../db/src/*"],
      "@findeg/ui": ["../ui/src"],
      "@findeg/ui/*": ["../ui/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    "src/**/*.cts",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "cypress"
  ]
}
