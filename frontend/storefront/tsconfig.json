{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@lib/*": ["./src/lib/*"],
      "@providers/*": ["./src/providers/*"],
      "@server/*": ["./src/server/*"],
      "@features/*": ["./src/features/*"],
      "@data/*": ["./src/data/*"],
      "@app/*": ["./src/app/*"],
      // Feature barrels migrated per docs/architecture/BACKEND_BARREL_MIGRATION_PLAN.md
      // must be listed here ahead of the wildcard below — TS path mapping
      // (unlike backend/package.json's exports field, which this alias
      // otherwise bypasses entirely) doesn't fall back to it once a feature
      // has its own entry.
      "@findeg/backend/features/administration": ["../../backend/src/features/administration/index.ts"],
      "@findeg/backend/features/media": ["../../backend/src/features/media/index.ts"],
      "@findeg/backend/features/notifications": ["../../backend/src/features/notifications/index.ts"],
      "@findeg/backend/features/order": ["../../backend/src/features/order/index.ts"],
      "@findeg/backend/*": ["../../backend/src/*"],
      "@findeg/env": ["../../packages/env/src"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".next", "dist", "cypress", ".turbo"]
}
