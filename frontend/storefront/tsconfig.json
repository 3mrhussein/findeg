{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@i18n/*": ["./src/i18n/*"],
      "@lib/*": ["./src/lib/*"],
      "@providers/*": ["./src/providers/*"],
      "@server/*": ["./src/server/*"],
      "@features/*": ["./src/features/*"],
      "@data/*": ["./src/data/*"],
      "@app/*": ["./src/app/*"],
      "@findeg/backend/features/school": ["../../backend/src/features/school/index.ts"],
      "@findeg/backend/features/order": ["../../backend/src/features/order/index.ts"],
      "@findeg/backend/*": ["../../backend/src/*"],
      "@findeg/env": ["../../packages/env/src"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", ".next", "dist", "cypress", ".turbo"]
}
