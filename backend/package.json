    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^1.3.0",
    "eslint": "^9.39.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.7.3",
    "vitest": "^1.3.0"
