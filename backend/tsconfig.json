{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@findeg/backend/*": ["./src/*"],
      "@findeg/db": ["../db/src"],
      "@findeg/db/*": ["../db/src/*"],
      "@findeg/env": ["../configs/env/src"]
    }
  },
  "include": ["src/**/*", "vitest*.config.ts", "../configs/vitest/postgres/global-setup.ts"],
  "exclude": ["node_modules", "dist"]
}
